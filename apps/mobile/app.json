{
  "expo": {
    "name": "ShowTracker",
    "slug": "showtracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "showtracker",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9012472e-03f5-4184-9cda-ee4b35517e63"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.matt.showtracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "webcredentials:tracker.mfranceschini.dev"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "dev.matt.showtracker",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5B45CC"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9012472e-03f5-4184-9cda-ee4b35517e63"
      },
      "apiUrl": "https://tracker.mfranceschini.dev",
      "router": {}
    },
    "owner": "francemj-organization"
  }
}
